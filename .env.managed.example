# ClickHouse Observability: Getting Started -> View connection details -> Env vars.
# Paste the three lines as they are.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<id>.otel.<region>.aws.clickhouse.cloud
OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer <ingestion-key>"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional: the service.version the app reports. Change it to simulate a deploy.
# APP_VERSION=1.0.0

# Optional: make this version a bad deploy. Signups get FAULT_LATENCY_MS slower
# (give or take half) and a FAULT_ERROR_RATE share of them fail (0 to 1).
# FAULT_LATENCY_MS=1500
# FAULT_ERROR_RATE=0.2

# Optional: how hard docs-burn clicks Docs (per user, per minute).
# DOCS_CLICKS_PER_MINUTE=30
# DOCS_BURN_USERS=1
